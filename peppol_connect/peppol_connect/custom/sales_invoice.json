{
  "sync_on_migrate": true,
  "custom_fields": [
    {
      "dt": "Sales Invoice",
      "fieldname": "peppol_transmission_section",
      "fieldtype": "Section Break",
      "label": "Peppol Transmission",
      "insert_after": "einvoice_is_correct",
      "collapsible": 1
    },
    {
      "dt": "Sales Invoice",
      "fieldname": "peppol_status",
      "fieldtype": "Select",
      "options": "Not Sent\nQueued\nSending\nSent\nDelivered\nFailed",
      "label": "Peppol Status",
      "read_only": 1,
      "insert_after": "peppol_transmission_section",
      "in_list_view": 1
    },
    {
      "dt": "Sales Invoice",
      "fieldname": "peppol_queue_link",
      "fieldtype": "Link",
      "options": "Peppol Document Queue",
      "label": "Peppol Queue",
      "read_only": 1,
      "insert_after": "peppol_status"
    },
    {
      "dt": "Sales Invoice",
      "fieldname": "peppol_column_break_1",
      "fieldtype": "Column Break",
      "insert_after": "peppol_queue_link"
    },
    {
      "dt": "Sales Invoice",
      "fieldname": "peppol_document_id",
      "fieldtype": "Data",
      "label": "Provider Document ID",
      "read_only": 1,
      "insert_after": "peppol_column_break_1"
    },
    {
      "dt": "Sales Invoice",
      "fieldname": "peppol_sent_date",
      "fieldtype": "Datetime",
      "label": "Sent Date",
      "read_only": 1,
      "insert_after": "peppol_document_id"
    },
    {
      "dt": "Sales Invoice",
      "fieldname": "peppol_delivered_date",
      "fieldtype": "Datetime",
      "label": "Delivered Date",
      "read_only": 1,
      "insert_after": "peppol_sent_date"
    },
    {
      "dt": "Sales Invoice",
      "fieldname": "peppol_error",
      "fieldtype": "Text",
      "label": "Transmission Error",
      "read_only": 1,
      "insert_after": "peppol_delivered_date"
    }
  ]
}
