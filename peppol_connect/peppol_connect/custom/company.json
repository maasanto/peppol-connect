{
 "custom_fields": [
  {
   "dt": "Company",
   "fieldname": "peppol_section",
   "fieldtype": "Section Break",
   "label": "Peppol Registration",
   "insert_after": "reporting_currency",
   "is_system_generated": 1,
   "collapsible": 1,
   "module": "Peppol Connect"
  },
  {
   "dt": "Company",
   "fieldname": "peppol_enabled",
   "fieldtype": "Check",
   "label": "Enable Peppol",
   "insert_after": "peppol_section",
   "is_system_generated": 1,
   "default": "0",
   "description": "Enable this company to send invoices via Peppol",
   "module": "Peppol Connect"
  },
  {
   "dt": "Company",
   "fieldname": "peppol_scheme",
   "fieldtype": "Select",
   "label": "Peppol Scheme",
   "insert_after": "peppol_enabled",
   "is_system_generated": 1,
   "options": "0208\n0007\n9925\n9956",
   "default": "0208",
   "depends_on": "eval:doc.peppol_enabled",
   "mandatory_depends_on": "eval:doc.peppol_enabled",
   "description": "0208: Belgian enterprise number, 0007: Swedish org number, 9925: French SIRET, 9956: Belgian CBE",
   "module": "Peppol Connect"
  },
  {
   "dt": "Company",
   "fieldname": "peppol_participant_id",
   "fieldtype": "Data",
   "label": "Peppol Participant ID",
   "insert_after": "peppol_scheme",
   "is_system_generated": 1,
   "depends_on": "eval:doc.peppol_enabled",
   "mandatory_depends_on": "eval:doc.peppol_enabled",
   "description": "Your company's Peppol ID (without scheme prefix)",
   "module": "Peppol Connect"
  },
  {
   "dt": "Company",
   "fieldname": "peppol_column_break",
   "fieldtype": "Column Break",
   "insert_after": "peppol_participant_id",
   "is_system_generated": 1,
   "module": "Peppol Connect"
  },
  {
   "dt": "Company",
   "fieldname": "peppol_provider_company_id",
   "fieldtype": "Data",
   "label": "Provider Company ID",
   "insert_after": "peppol_participant_id",
   "is_system_generated": 1,
   "read_only": 1,
   "description": "Company ID assigned by Peppol provider",
   "module": "Peppol Connect"
  },
  {
   "dt": "Company",
   "fieldname": "peppol_is_registered",
   "fieldtype": "Check",
   "label": "Is Registered",
   "insert_after": "peppol_provider_company_id",
   "is_system_generated": 1,
   "read_only": 1,
   "default": "0",
   "module": "Peppol Connect"
  },
  {
   "dt": "Company",
   "fieldname": "peppol_registration_date",
   "fieldtype": "Date",
   "label": "Registration Date",
   "insert_after": "peppol_is_registered",
   "is_system_generated": 1,
   "read_only": 1,
   "module": "Peppol Connect"
  }
 ],
 "custom_perms": [],
 "doctype": "Company",
 "links": [],
